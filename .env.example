# PAIRED engine — environment contract (copy to .env, never commit .env)
# Database (Neon Postgres). Fetch the real URI at runtime; never persist it in the repo.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Clerk (PRODUCTION instance for pairedart.com)
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe (Apex account, interim merchant of record — TEST MODE keys until M7 + separate live authorization)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# HTTP port (Render injects PORT)
PORT=10000

# Media storage (M2 — S3-compatible; ALL of bucket/region/keys required, else
# upload endpoints fail closed with 503 not_configured)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://...   # only for S3-compatible providers

# Connect onboarding (M2 — optional overrides; defaults point at the Studio)
# CONNECT_ONBOARDING_REFRESH_URL=https://pairedart.com/#/studio/payouts
# CONNECT_ONBOARDING_RETURN_URL=https://pairedart.com/#/studio/payouts

# Checkout (M3 — optional overrides; defaults point at the SPA orders view)
# CHECKOUT_SUCCESS_URL=https://pairedart.com/#/orders?checkout=success
# CHECKOUT_CANCEL_URL=https://pairedart.com/#/orders?checkout=canceled
